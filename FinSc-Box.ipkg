package FinSc-Box
version = 0.1.0
authors = "Justin"
brief   = "FinSc-Box: Minimal Hereditary Multiset & Maxel Algebra Engine"

depends = base >= 0.8.0
        , linear

modules = FinScBox.BoxInt
        , FinScBox.Interfaces
        , FinScBox.Box
        , FinScBox.HereditaryMSet
        , FinScBox.ProjectiveRotation
        , FinScBox.MultisetCodec
        , FinScBox.Views
        , FinScBox.BlackRedZoom
        , FinScBox.Lenses
        , FinScBox

sourcedir = "src"
