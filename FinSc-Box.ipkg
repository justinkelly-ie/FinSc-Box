package FinSc-Box
version = 0.1.0
authors = "Justin"
brief   = "FinSc-Box: Minimal Hereditary Multiset & Space-Time-Multiplicity Engine"

depends = base >= 0.8.0
        , linear

modules = FinScBox.BoxInt
        , FinScBox.Interfaces
        , FinScBox.Box
        , FinScBox.HereditaryMSet
        , FinScBox.Multiset
        , FinScBox.SpaceTime
        , FinScBox.SpaceStream
        , FinScBox.ProjectiveRotation
        , FinScBox.MultisetCodec
        , FinScBox.BlackRedZoom
        , FinScBox.Views
        , FinScBox.Lenses
        , FinScBox

sourcedir = "src"
